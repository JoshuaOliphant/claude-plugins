/specs
specs.backup.*

# Worktree isolation
trees/

# Beads runtime artifacts (DB and lock files tracked in .beads/.gitignore,
# but dolt/ dir and server lock need repo-level exclusion)
.beads/dolt/
.beads/dolt-server.lock

# Vault recommender generated index
.vault-recommender-index/

# Skill eval run workspaces (scratch artifacts from eval executions)
plugins/autonomous-sdlc/skills/*-workspace/
/trigger-eval-workspace/

# AGENTS.md (auto-generated by beads; project uses CLAUDE.md instead)
AGENTS.md